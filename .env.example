DB_PATH=data.db
OUTPUT_DIR=output
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5.0
REQUEST_DELAY_MIN=2.0
REQUEST_DELAY_MAX=4.0
WS_HEARTBEAT_INTERVAL=30
MAX_PLACES_PER_QUERY=20
SCROLL_ATTEMPTS=3
# ── Fuentes oficiales ──
HTTP_USER_AGENT=CityScout-Scraper/2.0 (+https://github.com/jhonhurtado/scrapper)
HTTP_HOST_DELAY_SECONDS=0.8
RESPECT_ROBOTS_TXT=true
MAX_PAGES_PER_PORTAL=8
INCLUDE_DEPARTMENTAL=true
# ONLY_DANE_CODES=15407,68079

# ── Ubicación verificada ──
GEO_MAX_KM=40
GEO_MAX_KM_LARGE=150
GEO_MIN_NAME_SIMILARITY=0.6
GEOCODER_GOOGLE_FALLBACK=true
# Navegador para ese respaldo (usa el instalado, no descarga nada):
# auto | brave | chrome | edge | chromium | playwright | none
SCRAPER_BROWSER=auto
# SCRAPER_BROWSER_PATH=/Applications/Brave Browser.app/Contents/MacOS/Brave Browser
